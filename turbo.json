{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "SERVICE_NAME",
    "DEPLOYMENT_ENVIRONMENT",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_DEBUG",
    "NEXT_PUBLIC_API_URL",
    "DATABASE_URL"
  ],
  "ui": "tui",
  "tasks": {
    "build:spec": {
      "cache": false
    },
    "api-gateway#build:spec": {
      "dependsOn": ["user-service#build:spec", "admin-service#build:spec"],
      "cache": false
    },
    "generate:api": {
      "dependsOn": ["api-gateway#build:spec"],
      "cache": false
    },
    "//#sync:postman": {
      "dependsOn": ["api-gateway#build:spec"],
      "cache": false,
      "outputs": ["postman/specs/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "dependsOn": ["^lint:fix"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
