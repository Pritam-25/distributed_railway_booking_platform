// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD
}

enum BookingStatus {
  PENDING
  SEATS_HELD
  PAYMENT_PENDING
  CONFIRMING
  CONFIRMED
  CANCELLING
  CANCELLED
  EXPIRED
  FAILED
}

enum PassengerGender {
  MALE
  FEMALE
  OTHER
}

enum BookingQuota {
  GENERAL
  LADIES
  SENIOR_CITIZEN
  PERSON_WITH_DISABILITY
  TATKAL
  PREMIUM_TATKAL
  DEFENCE
  FOREIGN_TOURIST
}

enum IdentityDocumentType {
  AADHAAR
  PAN
  PASSPORT
  VOTER_ID
  DRIVING_LICENSE
  STUDENT_ID
  GOVT_ISSUED_ID
}

enum SagaStep {
  HOLD_SEATS
  CREATE_PAYMENT
  CONFIRM_SEATS
}

enum SagaStatus {
  PENDING
  COMPLETED
  FAILED
  COMPENSATED
}

// ============================================================
// Models
// ============================================================

/* Main booking record representing a train reservation request. */
model Booking {
  id             String        @id @default(uuid())
  pnr            String        @unique
  userId         String        @map("user_id")
  scheduleId     String        @map("schedule_id")
  fromStationId  String        @map("from_station_id")
  toStationId    String        @map("to_station_id")
  status         BookingStatus @default(PENDING)
  totalPrice     Decimal       @default(0.0) @map("total_price") @db.Decimal(12, 2)
  paymentOrderId String?       @map("payment_order_id")
  version        Int           @default(0)
  failureReason  String?       @map("failure_reason")
  lockExpiresAt  DateTime?     @map("lock_expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  seats      BookingSeat[]
  passengers BookingPassenger[]
  sagaLogs   SagaLog[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentOrderId])
  @@map("bookings")
}

/* Seat allocation item associated with a booking, enriched from inventory SeatsHeld events. */
model BookingSeat {
  id              String        @id @default(uuid())
  bookingId       String        @map("booking_id")
  seatInventoryId String?       @map("seat_inventory_id")
  seatId          String        @map("seat_id")
  coachId         String?       @map("coach_id")
  coachNumber     String?       @map("coach_number")
  seatNumber      Int?          @map("seat_number")
  seatType        String?       @map("seat_type")
  berthType       String?       @map("berth_type")
  fromSequence    Int?          @map("from_sequence")
  toSequence      Int?          @map("to_sequence")
  price           Decimal?      @db.Decimal(12, 2)
  quota           BookingQuota?

  booking   Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passenger BookingPassenger?

  @@index([bookingId])
  @@index([seatInventoryId])
  @@map("booking_seats")
}

/* Passenger details linked 1:1 with a booked seat. */
model BookingPassenger {
  id              String                @id @default(uuid())
  bookingId       String                @map("booking_id")
  bookingSeatId   String?               @unique @map("booking_seat_id")
  fullName        String                @map("full_name")
  age             Int
  gender          PassengerGender
  berthPreference String?               @map("berth_preference")
  idType          IdentityDocumentType? @map("id_type")
  idNumber        String?               @map("id_number")

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  seat    BookingSeat? @relation(fields: [bookingSeatId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_passengers")
}

/* Execution step log for distributed saga orchestrator. */
model SagaLog {
  id        String     @id @default(uuid())
  bookingId String     @map("booking_id")
  step      SagaStep
  status    SagaStatus @default(PENDING)
  error     String?
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, step])
  @@index([status])
  @@map("saga_logs")
}

/* Idempotency tracking record for idempotent booking API requests. */
model BookingIdempotencyKey {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique @map("idempotency_key")
  bookingId      String   @map("booking_id")
  responseBody   Json     @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("booking_idempotency_keys")
}

/* Transactional outbox event for reliably publishing booking events to Kafka. */
model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  topic         String
  payload       Json
  headers       Json?
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  nextRetryAt   DateTime?    @map("next_retry_at")
  errorMessage  String?      @map("error_message")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("outbox_events")
}
