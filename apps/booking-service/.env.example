# Database
DATABASE_URL=postgresql://admin:password@localhost:5432/irctc_booking_db?sslmode=verify-full

# Redis
REDIS_URL=redis://localhost:6379

# Service
SERVICE_NAME=booking-service
PORT=4004
JWT_SECRET=your_jwt_secret_key
INVENTORY_GRPC_URL=localhost:50051
PAYMENT_GRPC_URL=localhost:50052
GRPC_INTERNAL_AUTH_TOKEN=replace-with-a-random-32-character-secret

# Kafka
KAFKA_CLIENT_ID=booking-service
KAFKA_BROKERS=localhost:9092