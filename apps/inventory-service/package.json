{
  "name": "inventory-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import @irctc/telemetry/instrumentation ./src/server.ts",
    "build": "tsc && tsc-alias && copyfiles -u 1 src/**/*.lua dist",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed": "pnpm prisma db seed",
    "docker:build": "docker build -t inventory-service:latest --build-arg SERVICE=inventory-service -f Dockerfile ../..",
    "docker:run": "docker run --rm --name inventory-service -p 50051:50051 --env-file .env inventory-service:latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.21",
    "copyfiles": "^2.4.1",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.23.0"
  },
  "dependencies": {
    "@irctc/contracts": "workspace:*",
    "@irctc/errors": "workspace:*",
    "@irctc/grpc": "workspace:*",
    "@irctc/http": "workspace:*",
    "@irctc/kafka": "workspace:*",
    "@irctc/logger": "workspace:*",
    "@irctc/redis": "workspace:*",
    "@irctc/telemetry": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@t3-oss/env-core": "^0.13.11",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.2",
    "nice-grpc": "^2.1.10",
    "prisma": "7.8.0",
    "zod": "^4.4.3"
  }
}
