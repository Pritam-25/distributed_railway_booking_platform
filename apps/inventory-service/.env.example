# Database
DATABASE_URL=postgresql://admin:password@localhost:5432/irctc_inventory_db?sslmode=verify-full

# Redis
REDIS_URL=redis://localhost:6379

# Service
SERVICE_NAME=inventory-service
PORT=4003
GRPC_PORT=50051
GRPC_INTERNAL_AUTH_TOKEN=replace-with-a-random-32-character-secret
JWT_SECRET=your_jwt_secret_key

# Kafka
KAFKA_CLIENT_ID=inventory-service
KAFKA_BROKERS=localhost:9092
