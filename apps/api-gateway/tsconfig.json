{
  "extends": "@repo/typescript-config/node.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "@config": ["./src/config/index.js"],
      "@auth": ["./src/auth/index.js"],
      "@health": ["./src/health/index.js"],
      "@ratelimit": ["./src/ratelimit/index.js"],
      "@resilience": ["./src/resilience/index.js"],
      "@routing": ["./src/routing/index.js"],
      "@routes": ["./src/routes/index.js"],
      "@proxy": ["./src/proxy/index.js"],
      "@utils": ["./src/utils/errors/index.js"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules", "dist", "prisma.config.ts", "vitest.config.ts"]
}
