{
  "name": "admin-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --import @irctc/telemetry/instrumentation ./src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node --import @irctc/telemetry/instrumentation ./dist/server.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "seed": "pnpm prisma db seed",
    "build:spec": "tsx src/openapi/generate-spec.ts",
    "docker:build": "docker build -t admin-service:latest --build-arg SERVICE=admin-service -f Dockerfile ../..",
    "docker:run": "docker run --rm --name admin-service -p 4002:4002 --env-file .env admin-service:latest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.19.21",
    "js-yaml": "^4.1.0",
    "prisma": "^7.8.0",
    "tsc-alias": "^1.9.0",
    "tsx": "^4.23.0"
  },
  "dependencies": {
    "@irctc/contracts": "workspace:*",
    "@irctc/errors": "workspace:*",
    "@irctc/http": "workspace:*",
    "@irctc/kafka": "workspace:*",
    "@irctc/logger": "workspace:*",
    "@irctc/middleware": "workspace:*",
    "@irctc/openapi": "workspace:*",
    "@irctc/telemetry": "workspace:*",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@t3-oss/env-core": "^0.13.11",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  }
}
