// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

enum TrainCategory {
  EXPRESS
  SUPERFAST
  MAIL
  PASSENGER
  VANDE_BHARAT
  RAJDHANI
  SHATABDI
  DURONTO
  JAN_SHATABDI
  GARIB_RATH
  DEMU
  MEMU
}

enum CoachType {
  GEN // General
  SL // Sleeper
  AC_3E // 3rd AC Economy
  AC_3A // 3rd AC
  AC_2A // 2nd AC
  AC_1A // 1st AC
  CC // Chair Car
  EC // Executive Chair Car
}

enum SeatType {
  LOWER
  MIDDLE
  UPPER
  SIDE_LOWER
  SIDE_UPPER
}

enum ScheduleStatus {
  DRAFT
  ACTIVE
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
  DEAD
}

// ============================================================
// Station
// ============================================================

/* Master railway station. Examples: NDLS (New Delhi), HWH (Howrah), PNBE (Patna). */
model Station {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  zone      String?
  state     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  routeStation RouteStation[]

  @@index([name])
  @@index([code])
  @@index([zone])
  @@index([isActive])
  @@map("stations")
}

// ============================================================
// Train
// ============================================================

/* Master train record independent of journey dates. */
model Train {
  id          String        @id @default(uuid())
  trainNumber String        @unique @map("train_number") @db.Char(5)
  trainName   String        @map("train_name")
  category    TrainCategory @default(PASSENGER)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  route         Route?
  coaches       Coach[]
  operatingDays OperatingDay[]
  schedules     Schedule[]

  @@index([trainNumber])
  @@index([trainName])
  @@index([category])
  @@index([isActive])
  @@map("trains")
}

// ============================================================
// Route
// ============================================================

/* Route assigned to a train, containing ordered station stops. */
model Route {
  id        String   @id @default(uuid())
  trainId   String   @unique @map("train_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  train        Train          @relation(fields: [trainId], references: [id], onDelete: Cascade)
  routeStation RouteStation[]

  @@index([isActive])
  @@map("routes")
}

// ============================================================
// Route Station
// ============================================================

/* Station stop inside a train route. */
model RouteStation {
  id                String   @id @default(uuid())
  routeId           String   @map("route_id")
  stationId         String   @map("station_id")
  stopNumber        Int      @map("stop_number")
  arrivalMinutes    Int?     @map("arrival_minutes")
  departureMinutes  Int?     @map("departure_minutes")
  distanceFromStart Int      @default(0) @map("distance_from_start")
  platformNumber    String?  @map("platform_number")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopNumber])
  @@unique([routeId, stationId])
  @@index([routeId])
  @@index([stationId])
  @@index([stopNumber])
  @@map("route_stations")
}

// ============================================================
// Coach
// ============================================================

/* Coach attached to a train (e.g. S1, A1, B1). */
model Coach {
  id          String    @id @default(uuid())
  trainId     String    @map("train_id")
  coachNumber String    @map("coach_number")
  coachType   CoachType @map("coach_type")
  totalSeats  Int       @map("total_seats")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  train Train  @relation(fields: [trainId], references: [id], onDelete: Cascade)
  seats Seat[]

  @@unique([trainId, coachNumber])
  @@index([trainId])
  @@index([isActive])
  @@map("coaches")
}

// ============================================================
// Seat
// ============================================================

/* Physical seat inside a coach. */
model Seat {
  id         String   @id @default(uuid())
  coachId    String   @map("coach_id")
  seatNumber Int      @map("seat_number")
  seatType   SeatType @map("seat_type")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  coach Coach @relation(fields: [coachId], references: [id], onDelete: Cascade)

  @@unique([coachId, seatNumber])
  @@index([coachId])
  @@index([seatNumber])
  @@map("seats")
}

// ============================================================
// Operating Day
// ============================================================

/* Weekly operating day for a train (0 = Sunday ... 6 = Saturday). */
model OperatingDay {
  id        String   @id @default(uuid())
  trainId   String   @map("train_id")
  dayOfWeek Int      @map("day_of_week")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  train Train @relation(fields: [trainId], references: [id], onDelete: Cascade)

  @@unique([trainId, dayOfWeek])
  @@index([trainId])
  @@map("operating_days")
}

// ============================================================
// Schedule
// ============================================================

/* Concrete train-run journey schedule for a specific date. */
model Schedule {
  id            String         @id @default(uuid())
  trainId       String         @map("train_id")
  departureDate DateTime       @map("departure_date")
  status        ScheduleStatus @default(ACTIVE)
  version       Int            @default(1)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  train Train @relation(fields: [trainId], references: [id], onDelete: Restrict)

  @@unique([trainId, departureDate])
  @@index([trainId, departureDate])
  @@index([departureDate])
  @@index([status, departureDate])
  @@map("schedules")
}

// ============================================================
// Admin
// ============================================================

/* Administrative system user. */
model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

// ============================================================
// Outbox Event
// ============================================================

/* Transactional outbox event for Kafka domain events. */
model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  topic         String
  payload       Json
  headers       Json?
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0) @map("retry_count")
  nextRetryAt   DateTime?    @map("next_retry_at")
  errorMessage  String?      @map("error_message")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  processedAt   DateTime?    @map("processed_at")

  @@index([status, createdAt])
  @@index([status, nextRetryAt])
  @@map("outbox_events")
}
